# ── Entorno ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos (Supabase PostgreSQL / local) ─────────
# Conexión Prisma. En producción usar la cadena de Supabase (con SSL).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karnes_db?schema=public

# ── CORS ────────────────────────────────────────────────
# Desarrollo: *
# Producción: lista separada por comas de orígenes permitidos (web y admin)
#   Ej.: https://sitio.com,https://admin.sitio.com
CORS_ORIGIN=*

# ── Auth ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refreshToken

# ── Storage de imágenes ─────────────────────────────────
# local | supabase
STORAGE_PROVIDER=local
# Solo para STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# URL pública base del backend (para construir URLs de archivos locales)
PUBLIC_BASE_URL=http://localhost:3000

# Solo para STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images
